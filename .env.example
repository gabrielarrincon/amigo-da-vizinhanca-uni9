# --- Obrigatórias ---
# String de conexão do PostgreSQL (Neon/Supabase). Localmente pode usar as DB_* abaixo.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# Frase secreta com 32+ caracteres. Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-frase-secreta-bem-longa-com-32-ou-mais-caracteres

# --- Opcionais ---
PORT=3000
JWT_EXPIRATION_MINUTES=60
# Só se o front-end for hospedado em OUTRO domínio (lista separada por vírgula)
# CORS_ORIGIN=https://meu-front.vercel.app
# AUTO_MIGRATE=false   # desliga as migrations automáticas no start

# --- Alternativa local sem DATABASE_URL ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=amigo_da_vizinhanca
# DB_USER=postgres
# DB_PASSWORD=sua_senha_do_postgres
